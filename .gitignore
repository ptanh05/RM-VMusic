# RM-VMusic
#
# Keep the reviewable, reproducible software surface in Git:
#   src/, tests/, configs/, docs/, README and dependency manifests.
# Data and generated artifacts are ignored by default. A reviewed dataset release
# can be whitelisted later, after its labels, provenance and license are approved.

# -----------------------------------------------------------------------------
# Official command-line entry points
# -----------------------------------------------------------------------------
# Historical/experimental scripts are local research history, not release code.
scripts/*
!scripts/run_all.py
!scripts/extract_features.py
!scripts/README.md

# -----------------------------------------------------------------------------
# Dataset policy
# -----------------------------------------------------------------------------
# Ignore all unreviewed, raw, experimental and generated data by default.
data/*

# Existing tracked data remain in Git history because .gitignore does not remove
# tracked files. Do not add new data until the data quality gate is complete.

# Official-v1 splits, caches and runs are reproducible build artifacts.
artifacts/

# -----------------------------------------------------------------------------
# Generated research results
# -----------------------------------------------------------------------------
# Historical tracked files are preserved, but new outputs must not be added
# automatically. Publish selected tables/figures deliberately after review.
outputs/
reports/

# -----------------------------------------------------------------------------
